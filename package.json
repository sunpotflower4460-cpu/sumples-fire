{
  "name": "sumples-fire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-release-bundle.mjs",
    "build:guide": "vite build plus-guide",
    "build:ios": "tsc -b && vite build --mode capacitor && node scripts/check-release-bundle.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ios:sync": "npm run build:ios && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check:bundle": "node scripts/check-release-bundle.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@vitejs/plugin-react": "^4.4.1",
    "framer-motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@cloudflare/vite-plugin": "^1.70.2",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.169.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
